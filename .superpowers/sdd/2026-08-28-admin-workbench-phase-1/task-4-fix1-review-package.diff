+    def test_freshness_contract_marks_all_covered_data_stale_after_expected_trade_day(self):
+        """Ignoring a completed trade day after the latest price would permit stale factor work."""
+        freshness = getattr(admin, "data_is_stale", None)
+        self.assertIsNotNone(freshness, "admin freshness contract must be public and pure")
+        if freshness is None:
+            return
+        self.assertTrue(
+            freshness(
+                date(2026, 8, 27),
+                today=date(2026, 8, 29),
+                is_trade_day=lambda day: day == date(2026, 8, 28),
+            )
+        )
+
